# Copy to .env.prod (and optionally .env.dev) and fill in. Both are gitignored by the .env.* rule;
# this file is the only one committed. Loaded by everything under scripts/ and by
# `docker compose -f docker-compose.prod.yml`.
#
# Quote every value. The file is sourced with `set -a`, so an unquoted path containing a space -
# and the iCloud Drive path below contains one - would be split into a command and fail.

# --- Models -------------------------------------------------------------------------------------
# Used by the openrouter llm profile. Fill it in so a prod run does not depend on which shell
# started it - but leave the line commented out rather than empty if you would rather keep using an
# exported one, because `set -a` makes an empty value here overwrite the exported one.
OPENROUTER_API_KEY=""
# Only needed if job-assistant.llm.tasks is repointed at the `requesty` profile.
REQUESTY_API_KEY=""

# --- Production database ------------------------------------------------------------------------
# Read by application-prod.yaml, which has no default for it, and by docker-compose.prod.yml.
# Choose something other than the dev password: the two databases should not share a credential.
DB_PASSWORD=

# --- Backups ------------------------------------------------------------------------------------
# Must be outside this repository. A dump contains the profile's name, email and phone, and this
# repository is public.
BACKUP_DIR="$HOME/job-assistant-backups"
# A second copy on different hardware. Empty disables mirroring, which means one disk failure is
# total loss - set it.
BACKUP_MIRROR="$HOME/Library/Mobile Documents/com~apple~CloudDocs/job-assistant-backups"
# Dumps older than this are pruned, except that the newest KEEP_MINIMUM are always kept.
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MINIMUM=7
